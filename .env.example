# ====================================================================
# BidderDecisions - Environment Configuration Template
# Copy this file to .env.local and configure your environment variables.
# Never commit real secrets to the repository.
# ====================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ====================================================================
# SUPABASE CONFIGURATION (Next.js SSR & Browser Client)
# Retrieve these from your Supabase Dashboard: Project Settings -> API
# ====================================================================

# Public Supabase URL (Used by both browser client and server client)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Public Anon Key (Safe for browser client usage with Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-token"

# Supabase Service Role Secret (OPTIONAL - Server-side admin tasks only; never expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret"

# Vite compatibility fallback keys (for client bundle resolution)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-token"

# ====================================================================
# OPENAI RESPONSES API CONFIGURATION (SERVER-SIDE ONLY)
# Never expose this key to client-side code or browser bundles.
# Used exclusively by app/api/extract-tender/route.ts
# ====================================================================
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"
